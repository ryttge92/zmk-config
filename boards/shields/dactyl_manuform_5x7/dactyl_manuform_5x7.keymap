#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/ext_power.h>

// keep all behavior settings for zmk studio
#define ZMK_BEHAVIORS_OMIT_KT

#define DEFAULT 0

#include "common_macros.dtsi"

&sl {
    release-after-ms = <2000>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
              &kp ESC                &kp NUMBER_1           &kp NUMBER_2           &kp NUMBER_3           &kp NUMBER_4           &kp NUMBER_5           &kp EQUAL                  &kp GRAVE              &kp NUMBER_6           &kp NUMBER_7           &kp NUMBER_8           &kp NUMBER_9           &kp NUMBER_0           &kp MINUS
              &kp TAB                &kp Q                  &kp W                  &kp E                  &kp R                  &kp T                  &kp INSERT                 &kp LG(R)              &kp Y                  &kp U                  &kp I                  &kp O                  &kp P                  &kp LBKT
              &kp LSHIFT             &kp A                  &kp S                  &kp D                  &kp F                  &kp G                  &kp CAPS                   &kp LC(LA(DEL))        &kp H                  &kp J                  &kp K                  &kp L                  &kp SEMICOLON          &kp SINGLE_QUOTE
              &kp LCTRL              &kp Z                  &kp X                  &kp C                  &kp V                  &kp B                  &to 4                      &kp PSCRN              &kp N                  &kp M                  &kp COMMA              &kp PERIOD             &kp SLASH              &kp BACKSLASH
              &kp NON_US_BACKSLASH   &kp RBKT               &kp LGUI               &kp SPACE              &kp LALT               &kp RALT               &to 0                  &kp LC(BACKSPACE)          &kp LC(LG(LEFT))       &kp LC(LG(RIGHT))      &to 3                  &kp BACKSPACE          &kp ENTER              &kp DEL                &studio_unlock
            
            >;
        };

        mouse_layer {
            display-name = "mouse";
            bindings = <
              &ktd ESC               &ktd NUMBER_1          &ktd NUMBER_2          &ktd NUMBER_3          &ktd NUMBER_4          &ktd NUMBER_5          &ktd EQUAL                 &ktd GRAVE             &ktd NUMBER_6          &ktd NUMBER_7          &ktd NUMBER_8          &ktd NUMBER_9          &ktd NUMBER_0          &ktd MINUS
              &ktd TAB               &ktd Q                 &ktd W                 &ktd E                 &ktd R                 &ktd T                 &ktd INSERT                &ktd LG(R)             &ktd Y                 &ktd U                 &ktd I                 &ktd O                 &ktd P                 &ktd LBKT
              &trans                 &ktd A                 &ktd S                 &ktd D                 &ktd F                 &ktd G                 &ktd CAPS                  &ktd LC(LA(DEL))       &to 2                  &mkp MB1               &mkp MB2               &ktd L                 &ktd SEMICOLON         &ktd SINGLE_QUOTE
              &trans                 &ktd Z                 &ktd X                 &ktd C                 &ktd V                 &ktd B                 &trans                     &ktd PSCRN             &mkp MB5               &mkp MB4               &ktd COMMA             &ktd PERIOD            &ktd SLASH             &ktd BACKSLASH
              &ktd NON_US_BACKSLASH  &ktd RBKT              &trans                 &ktd SPACE             &trans                 &trans                 &trans                 &ktd LC(BACKSPACE)         &ktd LC(LG(LEFT))      &ktd LC(LG(RIGHT))     &trans                 &ktd BACKSPACE         &ktd ENTER             &ktd DEL               &trans
            
            >;
        };

        scroll_layer {
            display-name = "scroll";
            bindings = <
              &ktd ESC               &ktd NUMBER_1          &ktd NUMBER_2          &ktd NUMBER_3          &ktd NUMBER_4          &ktd NUMBER_5          &ktd EQUAL                 &ktd GRAVE             &ktd NUMBER_6          &ktd NUMBER_7          &ktd NUMBER_8          &ktd NUMBER_9          &ktd NUMBER_0          &ktd MINUS
              &ktd TAB               &ktd Q                 &ktd W                 &ktd E                 &ktd R                 &ktd T                 &ktd INSERT                &ktd LG(R)             &ktd Y                 &ktd U                 &ktd I                 &ktd O                 &ktd P                 &ktd LBKT
              &trans                 &ktd A                 &ktd S                 &ktd D                 &ktd F                 &ktd G                 &ktd CAPS                  &ktd LC(LA(DEL))       &to 1                  &mkp MB1               &mkp MB2               &ktd L                 &ktd SEMICOLON         &ktd SINGLE_QUOTE
              &trans                 &ktd Z                 &ktd X                 &ktd C                 &ktd V                 &ktd B                 &trans                     &ktd PSCRN             &mkp MB5               &mkp MB4               &ktd COMMA             &ktd PERIOD            &ktd SLASH             &ktd BACKSLASH
              &ktd NON_US_BACKSLASH  &ktd RBKT              &trans                 &ktd SPACE             &trans                 &trans                 &trans                 &ktd LC(BACKSPACE)         &ktd LC(LG(LEFT))      &ktd LC(LG(RIGHT))     &mkp MB2               &ktd BACKSPACE         &ktd ENTER             &ktd DEL               &trans
            
            >;
        };
        
        navigation_layer {
            display-name = "navigation";
            bindings = <
              &trans                 &kp F1                 &kp F2                 &kp F3                 &kp F4                 &kp F5                 &kp F11                    &kp F12                &kp F6                 &kp F7                 &kp F8                 &kp F9                 &kp F10                &trans
              &trans                 &trans                 &trans                 &kp UP                 &trans                 &trans                 &trans                     &trans                 &trans                 &trans                 &kp PAGE_UP            &trans                 &trans                 &trans
              &trans                 &trans                 &kp LEFT               &kp DOWN               &kp RIGHT              &trans                 &trans                     &trans                 &trans                 &kp HOME               &kp PAGE_DOWN          &kp END                &trans                 &trans
              &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                     &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
              &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                     &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
            
            >;
        };

        function_layer {
            display-name = "func";
            bindings = <
              &trans                 &mon1                  &mon2                  &comp1                 &comp2                 &trans                 &trans                     &bt_clr_d              &bt_sel0               &bt_sel1               &bt_sel2               &bt_sel3               &bt_sel4               &trans
              &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                     &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
              &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &studio_unlock             &studio_unlock         &trans                 &trans                 &trans                 &trans                 &trans                 &trans
              &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &bootloader                &bootloader            &trans                 &trans                 &trans                 &trans                 &trans                 &trans
              &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                     &trans                 &trans                 &trans                 &trans                 &trans                 &out_ble_d             &out_usb_d
            >;
        };
        extra1 {
                status = "reserved";
            };

        extra2 {
                status = "reserved";
            };
    };
};
