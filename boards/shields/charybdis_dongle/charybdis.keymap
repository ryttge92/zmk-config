#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/ext_power.h>

// keep all behavior settings for zmk studio
#define ZMK_BEHAVIORS_OMIT_KT

#define DEFAULT 0

    &sl {
    release-after-ms = <3000>;
};


/ {
    macros {
        comp1: comp1 {
        compatible = "zmk,behavior-macro";
        label = "COMP1";
        #binding-cells = <0>;
        wait-ms = <100>;
        bindings =
            <&out OUT_USB>,
            <&kp F15>
            ;
        };

        comp2: comp2 {
        compatible = "zmk,behavior-macro";
        label = "COMP2";
        #binding-cells = <0>;
        wait-ms = <100>;
        bindings =
            <&out OUT_USB>,
            <&kp F16>,
            <&out OUT_BLE>,
            <&bt BT_SEL 0>
            ;
        };

        mon1: mon1 {
        compatible = "zmk,behavior-macro";
        label = "mon1";
        #binding-cells = <0>;
        wait-ms = <100>;
        bindings =
            <&out OUT_USB>,
            <&kp F13>
            ;
        };

        mon2: mon2 {
        compatible = "zmk,behavior-macro";
        label = "mon2";
        #binding-cells = <0>;
        wait-ms = <100>;
        bindings =
            <&out OUT_USB>,
            <&kp F14>
            ;
        }; 

    };

    behaviors {
        my_lt: my_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&sl>;
            display-name = "Layer-Tap";
        };

        my_lt_kp: my_layer_tap_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sl>;
            display-name = "Layer-Tap";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
              &kp ESC               &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp NUMBER_5             &kp NUMBER_6        &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0   &kp MINUS
              &kp TAB               &kp Q         &kp W         &kp E         &kp R             &kp T                    &kp Y               &kp U              &kp I         &kp O         &kp P          &kp LBKT
              &kp LSHIFT            &kp A         &kp S         &kp D         &kp F             &kp G                    &kp H               &kp J              &kp K         &kp L         &kp SEMICOLON  &kp SINGLE_QUOTE
              &kp LCTRL             &kp Z         &kp X         &kp C         &kp V             &kp B                    &kp N               &kp M              &kp COMMA     &kp PERIOD    &kp SLASH      &kp BACKSLASH
                                    &kp LGUI      &kp SPACE     &kp DEL       &my_lt_kp RALT 5  &kp LALT                 &my_lt 3 4          &kp ENTER          &kp BACKSPACE

            
            >;
        };

        mouse_layer {
            display-name = "mouse";
            bindings = <
              &trans                &trans        &trans        &trans        &trans        &trans                     &trans              &trans            &trans        &trans        &trans         &trans
              &trans                &trans        &trans        &trans        &trans        &trans                     &trans              &trans            &trans        &trans        &trans         &trans
              &trans                &trans        &trans        &trans        &trans        &trans                     &to 2               &mkp MB1          &mkp MB2      &trans        &trans         &trans
              &trans                &trans        &trans        &trans        &trans        &trans                     &trans              &trans            &trans        &trans        &trans         &trans
                                    &trans        &trans        &trans        &trans        &trans                     &trans              &trans            &trans        
            
            >;
        };

        scroll_layer {
            display-name = "scroll";
            bindings = <
              &trans                &trans        &trans        &trans        &trans        &trans                     &trans             &trans             &trans        &trans        &trans         &trans
              &trans                &trans        &trans        &trans        &trans        &trans                     &trans             &trans             &trans        &trans        &trans         &trans
              &trans                &trans        &trans        &trans        &trans        &trans                     &to 1              &mkp MB1           &mkp MB2      &trans        &trans         &trans
              &trans                &trans        &trans        &trans        &trans        &trans                     &trans             &trans             &trans        &trans        &trans         &trans
                                    &trans        &trans        &trans        &trans        &trans                     &trans             &trans             &trans        
            
            >;
        };
        
        navigation_layer {
            display-name = "navigation";
            bindings = <
              &trans                &trans                  &trans        &trans        &trans        &trans                     &trans             &trans        &trans           &trans        &trans         &trans
              &trans                &trans                  &trans        &kp UP        &trans        &trans                     &trans             &trans        &kp PAGE_UP      &trans        &trans         &trans
              &trans                &trans                  &kp LEFT      &kp DOWN      &kp RIGHT     &trans                     &trans             &kp HOME      &kp PAGE_DOWN    &kp END       &trans         &trans
              &trans                &kp NON_US_BACKSLASH    &kp RBKT      &trans        &trans        &trans                     &mkp MB5           &mkp MB4        &trans           &trans        &trans         &trans
                                    &trans                  &trans        &trans        &trans        &trans                     &trans             &trans        &trans           
            
            >;
        };

        function_layer {
            display-name = "func";
            bindings = <
              &trans                &mon1         &mon2         &comp1        &comp2        &trans                    &bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4   &bt BT_CLR 
              &trans                &trans        &trans        &trans        &trans        &trans                    &trans             &trans        &trans        &trans        &trans         &trans
              &trans                &trans        &trans        &trans        &trans        &trans                    &trans             &trans        &trans        &trans        &trans         &trans
              &bootloader           &trans        &trans        &trans        &trans        &trans                    &trans             &trans        &trans        &trans        &trans         &bootloader
                                    &trans        &trans        &trans        &trans        &trans                    &out OUT_BLE       &out OUT_USB  &trans
            >;
        };

        fkeys_layer {
            display-name = "fkeys";
            bindings = <
              &trans                &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                     &kp F6             &kp F7        &kp F8           &kp F9        &kp F10        &trans
              &trans                &trans        &trans        &trans        &trans        &trans                     &trans             &trans        &trans           &trans        &trans         &trans
              &trans                &trans        &trans        &trans        &trans        &trans                     &trans             &trans        &trans           &trans        &trans         &trans
              &trans                &trans        &trans        &trans        &trans        &trans                     &trans             &trans        &trans           &trans        &trans         &trans
                                    &trans        &trans        &trans        &trans        &trans                     &trans             &trans        &trans           
            
            >;
        };

        extra1 {
                status = "reserved";
            };

        extra2 {
                status = "reserved";
            };
    };
};
