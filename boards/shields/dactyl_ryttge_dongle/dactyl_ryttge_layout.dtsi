#include <physical_layouts.dtsi>

/*
 * Approximate positions for ZMK Studio. Order matches the transform:
 * 48 Charybdis keys, 4 extra keys (A B C D), 10 left thumb, 9 right thumb.
 */

/ {
    dactyl_ryttge_layout: dactyl_ryttge_layout {
        compatible = "zmk,physical-layout";
        display-name = "Dactyl-Ryttge";
