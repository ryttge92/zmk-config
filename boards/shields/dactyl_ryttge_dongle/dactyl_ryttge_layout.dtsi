#include <physical_layouts.dtsi>

/*
 * Approximate positions for ZMK Studio, in the same order as the matrix
 * transform (row by row, columns ascending).
 */

/ {
    dactyl_ryttge_layout: dactyl_ryttge_layout {
        compatible = "zmk,physical-layout";
        display-name = "Dactyl-Ryttge";
        transform = <&default_transform>;

        keys  //                     w   h     x     y     rot    rx    ry
