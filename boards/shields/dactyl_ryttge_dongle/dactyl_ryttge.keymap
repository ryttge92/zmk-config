#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/ext_power.h>

// keep all behavior settings for zmk studio
#define ZMK_BEHAVIORS_OMIT_KT

#define DEFAULT 0

#include "common_macros.dtsi"

/*
 * Bindings are in wiring order, the same as the matrix transform: one line per
 * matrix row, columns ascending (left C0-C5 then thumb T0-T2, right C0-C5 then
 * thumb T0-T2). Left C0 is the inner index column, so the left half reads
 * mirrored compared with the physical board.
 *
 * Main body: Charybdis 4x6 block, plus A B C D placeholders on the extra keys
 * under the ring and middle columns (R4 C2/C3 on each half).
 * Thumb clusters: number placeholders only, for testing the feel.
 *   Left:  1-9 on the 3x3 grid, 0 on the single key under 9 (R3 T2).
 *   Right: 1-9.
 * The Charybdis thumb keys (GUI SPC DEL RALT ALT / NAV BSPC ENT) are not mapped
 * yet, so the nav, func and fkeys layers have no way in until they are.
 */

    &sl {
    release-after-ms = <2000>;
};


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
              &kp NUMBER_5        &kp NUMBER_4        &kp NUMBER_3        &kp NUMBER_2                                                &kp N1              &kp N2              &kp N3                  &kp NUMBER_6        &kp NUMBER_7        &kp NUMBER_8        &kp NUMBER_9                                                &kp N1              &kp N2              &kp N3
              &kp T               &kp R               &kp E               &kp W               &kp NUMBER_1        &kp ESC             &kp N4              &kp N5              &kp N6                  &kp Y               &kp U               &kp I               &kp O               &kp NUMBER_0        &kp MINUS           &kp N4              &kp N5              &kp N6
              &kp G               &kp F               &kp D               &kp S               &kp Q               &kp TAB             &kp N7              &kp N8              &kp N9                  &kp H               &kp J               &kp K               &kp L               &kp P               &kp LBKT            &kp N7              &kp N8              &kp N9
              &kp B               &kp V               &kp C               &kp X               &kp A               &kp LSHIFT                                                  &kp N0                  &kp N               &kp M               &kp COMMA           &kp PERIOD          &kp SEMICOLON       &kp SINGLE_QUOTE
                                                      &kp B               &kp A               &kp Z               &kp LCTRL                                                                                                                   &kp C               &kp D               &kp SLASH           &kp BACKSLASH
            >;
        };

        mouse_layer {
            display-name = "mouse";
            bindings = <
              &ktd N5             &ktd N4             &ktd N3             &ktd N2                                                     &trans              &trans              &trans                  &ktd N6             &ktd N7             &ktd N8             &ktd N9                                                     &trans              &trans              &trans
              &ktd T              &ktd R              &ktd E              &ktd W              &ktd N1             &ktd ESC            &trans              &trans              &trans                  &ktd Y              &ktd U              &ktd I              &ktd O              &ktd N0             &ktd MINUS          &trans              &trans              &trans
              &ktd G              &ktd F              &ktd D              &ktd S              &ktd Q              &ktd TAB            &trans              &trans              &trans                  &to 2               &mkp MB1            &mkp MB2            &ktd L              &ktd P              &ktd LBKT           &trans              &trans              &trans
              &ktd B              &ktd V              &ktd C              &ktd X              &ktd A              &trans                                                      &trans                  &ktd N              &ktd M              &ktd COMMA          &ktd PERIOD         &ktd SEMICOLON      &ktd SINGLE_QUOTE
                                                      &trans              &trans              &ktd Z              &trans                                                                                                                      &trans              &trans              &ktd SLASH          &ktd BACKSLASH
            >;
        };

        scroll_layer {
            display-name = "scroll";
            bindings = <
              &ktd N5             &ktd N4             &ktd N3             &ktd N2                                                     &trans              &trans              &trans                  &ktd N6             &ktd N7             &ktd N8             &ktd N9                                                     &trans              &trans              &trans
              &ktd T              &ktd R              &ktd E              &ktd W              &ktd N1             &ktd ESC            &trans              &trans              &trans                  &ktd Y              &ktd U              &ktd I              &ktd O              &ktd N0             &ktd MINUS          &trans              &trans              &trans
              &ktd G              &ktd F              &ktd D              &ktd S              &ktd Q              &ktd TAB            &trans              &trans              &trans                  &to 0               &mkp MB1            &mkp MB2            &ktd L              &ktd P              &ktd LBKT           &trans              &trans              &trans
              &ktd B              &ktd V              &ktd C              &ktd X              &ktd A              &trans                                                      &trans                  &ktd N              &ktd M              &ktd COMMA          &ktd PERIOD         &ktd SEMICOLON      &ktd SINGLE_QUOTE
                                                      &trans              &trans              &ktd Z              &trans                                                                                                                      &trans              &trans              &ktd SLASH          &ktd BACKSLASH
            >;
        };

        navigation_layer {
            display-name = "navigation";
            bindings = <
              &trans              &trans              &trans              &trans                                                      &trans              &trans              &trans                  &trans              &trans              &trans              &trans                                                      &trans              &trans              &trans
              &trans              &trans              &kp UP              &trans              &trans              &trans              &trans              &trans              &trans                  &trans              &trans              &kp PAGE_UP         &trans              &trans              &trans              &trans              &trans              &trans
              &trans              &kp RIGHT           &kp DOWN            &kp LEFT            &trans              &trans              &trans              &trans              &trans                  &trans              &kp HOME            &kp PAGE_DOWN       &kp END             &trans              &trans              &trans              &trans              &trans
              &trans              &trans              &trans              &kp RBKT            &trans              &trans                                                      &trans                  &mkp MB5            &mkp MB4            &trans              &trans              &trans              &trans
                                                      &trans              &trans              &kp NON_US_BACKSLASH&trans                                                                                                                      &trans              &trans              &trans              &trans
            >;
        };

        function_layer {
            display-name = "func";
            bindings = <
              &trans              &comp2              &comp1              &mon2                                                       &trans              &trans              &trans                  &bt_sel0            &bt_sel1            &bt_sel2            &bt_sel3                                                    &trans              &trans              &trans
              &trans              &trans              &trans              &trans              &mon1               &trans              &trans              &trans              &trans                  &trans              &trans              &trans              &trans              &bt_sel4            &bt_clr_d           &trans              &trans              &trans
              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans                  &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans
              &trans              &trans              &trans              &trans              &trans              &trans                                                      &trans                  &trans              &trans              &trans              &trans              &trans              &trans
                                                      &trans              &trans              &trans              &bootloader                                                                                                                 &trans              &trans              &trans              &bootloader
            >;
        };

        fkeys_layer {
            display-name = "fkeys";
            bindings = <
              &kp F5              &kp F4              &kp F3              &kp F2                                                      &trans              &trans              &trans                  &kp F6              &kp F7              &kp F8              &kp F9                                                      &trans              &trans              &trans
              &kp F11             &trans              &trans              &trans              &kp F1              &trans              &trans              &trans              &trans                  &kp F12             &trans              &trans              &trans              &kp F10             &trans              &trans              &trans              &trans
              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans                  &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans
              &trans              &trans              &trans              &trans              &trans              &trans                                                      &trans                  &trans              &trans              &trans              &trans              &trans              &trans
                                                      &trans              &trans              &trans              &trans                                                                                                                      &trans              &trans              &trans              &trans
            >;
        };

        extra1 {
                status = "reserved";
            };

        extra2 {
                status = "reserved";
            };
    };
};
